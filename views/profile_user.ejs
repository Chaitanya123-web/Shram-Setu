<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>ShramSetu | Profile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: ui-sans-serif, system-ui, sans-serif;
    }

    body {
      background: #d8f9ff;
      padding: 40px;
    }

    /* ---------- HEADER ---------- */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .brand {
      font-size: 24px;
      font-weight: 700;
      color: blue;
    }

    /* ---------- MAIN CONTAINER ---------- */
    .profile-wrapper {
      max-width: 1000px;
      margin: auto;
      background: #fff;
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 32px;
    }

    /* ---------- LEFT CARD ---------- */
    .left-card {
      border: 1px solid #d8f9ff;
      background-color: #d8f9ff;
      border-radius: 16px;
      padding: 24px;
      text-align: center;
    }

    .profile-picture {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 16px;
    }

    .user-name {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .user-role {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 16px;
    }

    .stats {
      display: flex;
      justify-content: space-around;
      margin-bottom: 20px;
    }

    .stat h3 {
      font-size: 18px;
      font-weight: 600;
    }

    .stat p {
      font-size: 12px;
      color: #6b7280;
    }

    .verified {
      text-align: left;
      font-size: 14px;
      color: #374151;
    }

    .verified p {
      margin-bottom: 8px;
    }

    /* ---------- RIGHT CONTENT ---------- */
    .right-content h2 {
      font-size: 22px;
      margin-bottom: 8px;
    }

    .location {
      font-size: 14px;
      color: #6b7280;
      margin-bottom: 24px;
    }

    .info p {
      font-size: 15px;
      margin-bottom: 10px;
    }

    .label {
      font-weight: 600;
    }

    /* ---------- REVIEWS ---------- */
    .reviews {
      margin-top: 32px;
    }

    .review-card {
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
      background: #fafafa;
    }

    .review-card p {
      font-size: 14px;
      margin-bottom: 6px;
    }

    .review-author {
      font-size: 12px;
      color: #6b7280;
    }

    /* ---------- UPLOAD BUTTON ---------- */
    .file-label {
      display: inline-block;
      margin-top: 16px;
      padding: 10px 20px;
      background: blue;
      color: white;
      border-radius: 999px;
      cursor: pointer;
      font-size: 14px;
      border: none;
    }

    .file-input {
      display: none;
    }

  </style>
</head>

<body>

  <!-- PROFILE -->
  <div class="profile-wrapper">

    <!-- LEFT -->
    <div class="left-card">
      <img src="./images/profileuploads/<%= user.profilepic %>" 
           alt="Profile Picture" 
           class="profile-picture">

      <div class="user-name"><%= user.name %></div>
      <div class="user-role">User</div>

      <div class="stats">
        <div class="stat">
          <h3><%= user.posts ? user.posts.length : 0 %></h3>
          <p>Jobs Posted</p>
        </div>
        <div class="stat">
          <h3>—</h3>
          <p>Experience</p>
        </div>
      </div>

      <div class="verified">
        <p>✔ Identity verified</p>
        <p>✔ Email verified</p>
        <p>✔ Phone verified</p>
      </div>

      <form action="/uploadprofile" method="post" enctype="multipart/form-data">
        <label for="fileUpload" class="file-label">Select Picture</label>
        <input type="file" id="fileUpload" class="file-input" name="image">
        <br>
        <button type="submit" class="file-label">Change Picture</button>
      </form>
    </div>

    <!-- RIGHT -->
    <div class="right-content">
      <h2>About <%= user.name %></h2>
      <div class="location">
        📍 <%= user.formattedAddress || 'Location not provided' %>
      </div>


      <div class="info">
        <p><span class="label">Mobile:</span> <%= user.mobile %></p>
      </div>

      <div class="reviews">
        <h3>What people say on ShramSetu</h3>

        <div class="review-card">
          <p>“Very reliable and professional. Easy to communicate.”</p>
          <div class="review-author">— Verified Client</div>
        </div>

        <div class="review-card">
          <p>“Great experience, highly recommended.”</p>
          <div class="review-author">— ShramSetu User</div>
        </div>
      </div>
    </div>

  </div>

</body>
</html>